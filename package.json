{
  "name": "@vaam-apps/vitepress-md3",
  "version": "0.0.0",
  "description": "A Material Design 3 theme for VitePress — standard or Expressive, generated from one seed colour. The house style of every vaam-apps documentation site.",
  "license": "MIT",
  "author": "Vaam Apps",
  "homepage": "https://vaam-apps.github.io/vitepress-md3/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/vitepress-md3.git"
  },
  "bugs": {
    "url": "https://github.com/vaam-apps/vitepress-md3/issues"
  },
  "keywords": [
    "vitepress",
    "vitepress-theme",
    "material-design",
    "material-3",
    "material-you",
    "m3-expressive",
    "documentation"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/theme/index.ts",
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./styles/*": "./src/theme/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/theme",
    "src/shared",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm run build && pnpm --filter ./docs dev",
    "docs:build": "pnpm run build && pnpm --filter ./docs build",
    "docs:preview": "pnpm --filter ./docs preview",
    "format": "biome check --write .",
    "generate": "node scripts/generate-shapes.ts",
    "lint": "biome check . && markdownlint-cli2",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "vitepress": "^1.6.0 || ^2.0.0-alpha.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@material/material-color-utilities": "0.4.0",
    "@types/node": "^26",
    "markdownlint-cli2": "^0.23.3",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
